{
  "name": "oasis-hydro-suite",
  "private": true,
  "version": "1.2.0",
  "author": "OASIS HYDRO SUITE Engineering",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Suite d'ingénierie hydrologique, hydraulique routière et cartographie SIG (Web & Desktop Electron)",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:local": "node scripts/start-local.mjs",
    "build": "vite build",
    "build:electron": "vite build --base=./ && node scripts/build-electron-backend.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release coverage electron/dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:start": "npm run build:electron && electron electron/main.cjs",
    "package:win": "npm run build:electron && electron-builder --win --x64 --config electron-builder.json",
    "package:dir": "npm run build:electron && electron-builder --dir --config electron-builder.json",
    "ci:verify": "npm run lint && npm run format:check && npm test && npm run build && npm run build:electron"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.0",
    "jsdom": "^31.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.16.0",
    "supertest": "^7.3.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.8.3"
  }
}
